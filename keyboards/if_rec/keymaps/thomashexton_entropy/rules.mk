# Use the shared users/thomashexton code even though this sibling keymap has a
# different name.
USER_NAME = thomashexton

# Minimum required for Entropy/Vial live keymap editing.
VIA_ENABLE = yes
VIAL_ENABLE = yes
VIAL_INSECURE = yes
LTO_ENABLE = yes

# Keep the experiment focused. Combos remain enabled by the shared userspace
# and become four editable Vial combo slots.
QMK_SETTINGS = no
TAP_DANCE_ENABLE = no
KEY_OVERRIDE_ENABLE = no
MIDI_ENABLE = no
MOUSEKEY_ENABLE = no
